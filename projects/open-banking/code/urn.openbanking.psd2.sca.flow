Flow urn.openbanking.psd2.sca
     Basepath ""
     Inputs consent_id redirect_uri
// Flow starting
Log "@info Start executing Openbanking flow"
// Feedback message
feedback = {}
appUrl = {}
// Max repeate
Repeat 3 times max
     // Create an instance of OpenBanking Consent Service 
     openBankingConsentService = Call org.gluu.agama.openbanking.OpenbankingConsentService#getInstance 
     // Validate consent with Consent Engine (8)
     validationResult = Call openBankingConsentService validateConsent reqObject
     // If Consent Id is valid
     When validationResult.valid is true
          // Valid message
          Log "@info Initial Consent status is valid"
          // Send RFAC response (JWS + redirect URL) to app   (11)
          rfacResponsePayload = Call openBankingConsentService sendRFACResponseToApp 
          RFAC __________
          // Check Response status
          When rfacResponse.succeed is true
               // RFAC response messsage
               Log "@info RFAC Response send successfully"
               // Verify JWS and validate consent status  (23, 24)
               consentStatus = Call openBankingConsentService verifyConsentStatus 
               // Verify  consent status
               When consentStatus.valid is true
                    // JWS and Consent status verified
                    Log "@info  JWS and Consent status verified"
                    // Return consentId, AuthType, Success
                    Finish jwsVerify
               Otherwise
                    // Error message
                    feedback.errorMessage = jwsVerify.message
     Otherwise
          // Not valid message
          Log "@info Consent Id is not valid"
          // Error message
          feedback.errorMessage = validationResult.message