Flow urn.openbanking.psd2.sca
     Basepath ""
// Flow starting
Log "@info Start executing Openbanking flow"
// Feedback message
feedback = {}
// Max repeate
Repeat 3 times max
     // Create an instance of OpenBanking Consent Service 
     openBankingConsentService = Call org.gluu.agama.openbanking.OpenbankingConsentService#getInstance 
     // Validate consent with Consent Engine (8)
     validationResult = Call openBankingConsentService validateConsent reqObject
     // If Consent Id is valid
     When validationResult.valid is true
          // Valid message
          Log "@info Initial Consent status is valid"
          // Prepare RFAC response payload   (11)
          rfacResponsePayload = Call openBankingConsentService prepareRfacRespPayload 
          // Making RFAC call
          Log "@info Making RFAC call to external app"
          // RFAC call to external app
          resultFromApp = RFAC "https://external-app.example.com/start?payload=${rfacResponsePayload}"
          // Verify apps returned result
          Log "@info Verify external app return result"
          // Verify final status
          verifyFinalStatus = Call openBankingConsentService verifyExternalAppResult resultFromApp reqObject
          // Checking final staus
          When verifyFinalStatus.valid is true
               // Final verification done
               Log "@info Final verification successfully done"
          Otherwise
               // Verification failed
               Log "@info Varification faild reason: %" verifyFinalStatus.message
     Otherwise
          // Not valid message
          Log "@info Consent Id is not valid"
          // Error message
          feedback.errorMessage = validationResult.message