Flow urn.openbanking.psd2.sca
     Basepath ""
     Inputs consent_id redirect_uri
// Flow starting
Log "@info Start executing Openbanking flow"
// Feedback message
feedback = {}
// Max repeate
Repeat 3 times max
     // Create and instance of Agama Consent Service 
     agamaConsentService = Call org.gluu.agama.user.AgamaConsentService#getInstance 
     // Validate consent with Consent Engine (8)
     validationResult = Call agamaConsentService validateConsent consent_id redirect_uri
     // If Consent Id is valid
     When validationResult.valid is true
          // Valid message
          Log "@info Consent Id is valid"
          // Return RFAC Response in signed JWS (11)
          rfacResponse = Call agamaConsentService RFACResponse 
          // Check Response status
          When rfacResponse.success is true
               // RFAC response messsage
               Log "@info RFAC Response send successfully"
               // Verify JWS and validate consent  (23, 24)
               jwsVerify = Call agamaConsentService JWSVerify jwsVeriyData
               // Verify JWS and consent status
               When jwsVerify.valid is true
                    // JWS and Consent status verified
                    Log "@info  JWS and Consent status verified"
                    // Return consentId, AuthType, Success
                    Finish jwsVerify
               Otherwise
                    // Error message
                    feedback.errorMessage = jwsVerify.message
     Otherwise
          // Not valid message
          Log "@info Consent Id is not valid"
          // Error message
          feedback.errorMessage = validationResult.message