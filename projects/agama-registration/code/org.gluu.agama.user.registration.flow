Flow org.gluu.agama.user.registration
     Basepath ""
// Create json variable for UI feedback.
uiFeedback = {}
// Iterate x times max
max = Repeat 10 times max
     // Retrieve user profile  from UI
     uiInput = RRF "profile.ftlh" uiFeedback
     // Assign userName and email  to a variable
     email = uiInput.mail
     userName = uiInput.uid
     // Create an instance of User Registration Class
     userRegistrationService = Call org.gluu.agama.user.UserRegistration#getInstance 
     // Check user already exist or not
     userData = Call userRegistrationService getUserEntityByMail email
     // User with same email not exists
     emailUnknown = userData.empty
     // User with same email not exists
     When userData.empty is true
          // Unique mail found
          Log "@info User not found with mail %" email
          // Assign physical DB attributes to a variable
          Keys = uiInput.uid
          // Call user registration service method to register a new user
          inum | E = Call userRegistrationService addNewUser uiInput
          // If no error
          When inum is not null
               // Show user creation log
               Log "@info User % has been created" inum
               // User provided UI Input
               Log "@trace UI inpurt : %" uiInput
               // Assign User Id (userName) to a variable
               uid = uiInput.uid
               // Successful user registration
               it_kytua = {success:true, data: { userId: uid}}
               Finish it_kytua
          // User registration failed 
          Log "@info User registration failed. Error : %" E
     // User already exists
     Log "@trace User alreay exists with mail: %" email
     // User with  already exists
     uiFeedback.errorMessage = "UserAlreadyExists"
// Maximum attempt has been reached
Log "@info  The maximum registration attempt has been reached!"
// Registration enrollment  flow failed
it_zeahq = {success:false, error: "Registration enrollment  flow failed"}
Finish it_zeahq